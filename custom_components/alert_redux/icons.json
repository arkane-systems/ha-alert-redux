{
  "services": {
    "fire": {
      "service": "mdi:alert-plus"
    },
    "dismiss": {
      "service": "mdi:alert-remove"
    },
    "ack": {
      "service": "mdi:check-circle"
    },
    "unack": {
      "service": "mdi:check-circle-outline"
    },
    "snooze": {
      "service": "mdi:alarm-snooze"
    },
    "disable": {
      "service": "mdi:bell-off-outline"
    },
    "enable": {
      "service": "mdi:bell-outline"
    },
    "suspend": {
      "service": "mdi:timer-pause-outline"
    }
  }
}
