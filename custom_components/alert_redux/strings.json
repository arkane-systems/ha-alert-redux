{
  "config": {
    "step": {
      "user": {
        "title": "Alert Redux",
        "description": "Set up Alert Redux alerting. Global defaults can be changed afterwards in the integration's options."
      }
    },
    "abort": {
      "single_instance_allowed": "[%key:common::config_flow::abort::single_instance_allowed%]"
    }
  },
  "config_subentries": {
    "alert": {
      "entry_type": "Alert",
      "initiate_flow": {
        "user": "Add alert"
      },
      "step": {
        "user": {
          "title": "Add an alert",
          "description": "Choose the kind of alert.",
          "menu_options": {
            "manual": "Manual: fired and dismissed by actions",
            "state": "State: an entity is in a given state",
            "template": "Template: a template is true"
          }
        },
        "manual": {
          "title": "Add a manual alert",
          "description": "A manual alert is fired and dismissed by the `alert_redux.fire` and `alert_redux.dismiss` actions.",
          "data": {
            "name": "Name",
            "priority": "Priority",
            "icon": "Icon",
            "acknowledgeable": "Acknowledgeable",
            "user_dismissable": "Dismissable from the card",
            "subject_entity": "Subject entity"
          },
          "data_description": {
            "name": "Shown on the card and used as the notification title. The entity ID is derived from it when the alert is created.",
            "priority": "Sets the alert's colour and sort order.",
            "icon": "Leave empty to use the priority's default icon.",
            "acknowledgeable": "Turn off for alerts that must not be silenced.",
            "user_dismissable": "Show a dismiss button on the card. The dismiss action always works, whatever this is set to.",
            "subject_entity": "Optional. The entity the alert is about, for use in messages. Leave empty to use the watched entity, if there is one."
          },
          "sections": {
            "notifications": {
              "name": "Notifications and messages",
              "description": "Who is notified, how often reminders are sent, and what the messages say.",
              "data": {
                "use_default_groups": "Use the default notifier groups",
                "notifier_groups": "Notifier groups",
                "use_default_reminders": "Use the default reminder schedule",
                "reminder_schedule": "Reminder schedule",
                "message": "On message",
                "display_message": "Card message",
                "reminder_message": "Reminder message",
                "done_message": "Done message"
              },
              "data_description": {
                "use_default_groups": "Send to the default notifier groups set in the integration's options. Turn off to choose this alert's own groups.",
                "notifier_groups": "Used when the default groups are turned off. Leave empty to notify nobody.",
                "use_default_reminders": "Use the default reminder schedule set in the integration's options. Turn off to set this alert's own.",
                "reminder_schedule": "Used when the default schedule is turned off. Minutes between reminders while the alert is firing and unacknowledged, e.g. `10, 20, 30, 60`: the last gap repeats. Leave empty for no reminders.",
                "message": "Optional. Sent when the alert starts firing, and shown on the card. A template: it can use `name`, `subject_entity_name`, `fire_count`, `fire_data`, `duration`, and entity states. Leave empty for the default: the alert's name, followed by \"is firing.\"",
                "display_message": "Optional. A different message for the card, if the on message isn't what you want shown there. Also a template.",
                "reminder_message": "Optional. Sent as a reminder while the alert is still firing. A template, as for the on message; `duration` is how long it has been firing. Leave empty for the default, which gives the name and that duration.",
                "done_message": "Optional. Sent when the alert stops firing. A template, as for the on message; `duration` is how long it fired, and `end_reason` is `resolved`, `dismissed`, or `no_data`. Leave empty for the default."
              }
            }
          }
        },
