{
  "config": {
    "step": {
      "user": {
        "title": "Alert Redux",
        "description": "Set up Alert Redux alerting. Global defaults can be changed afterwards in the integration's options."
      }
    },
    "abort": {
      "single_instance_allowed": "[%key:common::config_flow::abort::single_instance_allowed%]"
    }
  },
  "config_subentries": {
    "alert": {
      "entry_type": "Alert",
      "initiate_flow": {
        "user": "Add alert"
      },
      "step": {
        "user": {
          "title": "Add an alert",
          "description": "Choose the kind of alert.",
          "menu_options": {
            "manual": "Manual: fired and dismissed by actions",
            "state": "State: an entity is in a given state",
            "template": "Template: a template is true"
          }
        },
        "manual": {
          "title": "Add a manual alert",
          "description": "A manual alert is fired and dismissed by the `alert_redux.fire` and `alert_redux.dismiss` actions.",
          "data": {
            "name": "Name",
            "priority": "Priority",
            "icon": "Icon",
            "acknowledgeable": "Acknowledgeable",
            "user_dismissable": "Dismissable from the card",
            "subject_entity": "Subject entity"
          },
          "data_description": {
            "name": "Shown on the card and used as the notification title. The entity ID is derived from it when the alert is created.",
            "priority": "Sets the alert's colour and sort order.",
            "icon": "Leave empty to use the priority's default icon.",
            "acknowledgeable": "Turn off for alerts that must not be silenced.",
            "user_dismissable": "Show a dismiss button on the card. The dismiss action always works, whatever this is set to.",
            "subject_entity": "Optional. The entity the alert is about, for use in messages. Leave empty to use the watched entity, if there is one."
          }
        },
        "state": {
          "title": "Add a state alert",
          "description": "A state alert fires while an entity is in a given state, e.g. a door sensor is `on`.",
          "data": {
            "name": "[%key:component::alert_redux::config_subentries::alert::step::manual::data::name%]",
            "priority": "[%key:component::alert_redux::config_subentries::alert::step::manual::data::priority%]",
            "icon": "[%key:component::alert_redux::config_subentries::alert::step::manual::data::icon%]",
            "entity_id": "Entity",
            "target_state": "State",
            "condition": "Extra condition",
            "delay_on": "Delay before firing",
            "delay_off": "Delay before ending",
            "acknowledgeable": "[%key:component::alert_redux::config_subentries::alert::step::manual::data::acknowledgeable%]",
            "subject_entity": "[%key:component::alert_redux::config_subentries::alert::step::manual::data::subject_entity%]",
            "no_data_grace": "No-data grace period"
          },
          "data_description": {
            "name": "[%key:component::alert_redux::config_subentries::alert::step::manual::data_description::name%]",
            "priority": "[%key:component::alert_redux::config_subentries::alert::step::manual::data_description::priority%]",
            "icon": "[%key:component::alert_redux::config_subentries::alert::step::manual::data_description::icon%]",
            "entity_id": "The entity to watch.",
            "target_state": "The alert fires while the entity is in this state, e.g. `on` or `open`. Targeting `unavailable` or `unknown` alerts on that state; otherwise those states mean the alert has no data.",
            "condition": "Optional. A template that must also render true for the alert to fire; when it stops being true, the alert ends.",
            "delay_on": "Optional. How long the condition must hold before the alert fires.",
            "delay_off": "Optional. How long the condition must stay false before the alert stops firing. Absorbs brief flickers.",
            "acknowledgeable": "[%key:component::alert_redux::config_subentries::alert::step::manual::data_description::acknowledgeable%]",
            "subject_entity": "[%key:component::alert_redux::config_subentries::alert::step::manual::data_description::subject_entity%]",
            "no_data_grace": "Optional. How long a firing alert keeps firing while its inputs have no data. Leave empty to use the global default."
