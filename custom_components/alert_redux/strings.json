  "entity": {
    "alert_redux": {
      "alert": {
        "state": {
          "idle": "Idle",
          "active": "Active",
          "ack": "Acknowledged",
          "no_data": "No data"
        },
        "state_attributes": {
          "priority": {
            "state": {
              "emergency": "[%key:component::alert_redux::selector::priority::options::emergency%]",
              "critical": "[%key:component::alert_redux::selector::priority::options::critical%]",
              "warning": "[%key:component::alert_redux::selector::priority::options::warning%]",
              "notice": "[%key:component::alert_redux::selector::priority::options::notice%]",
              "informational": "[%key:component::alert_redux::selector::priority::options::informational%]"
            }
          }
        }
      }
    }
  },
  "selector": {
    "priority": {
      "options": {
        "emergency": "Emergency",
        "critical": "Critical",
        "warning": "Warning",
        "notice": "Notice",
        "informational": "Informational"
      }
    }
  },
  "services": {
    "fire": {
      "name": "Fire",
      "description": "Fires a manual alert. Firing an alert that is already firing adds to its fire count and keeps its acknowledgement.",
      "fields": {
        "data": {
          "name": "Data",
          "description": "Variables made available to the alert's message templates as `fire_data`."
        }
      }
    },
    "dismiss": {
      "name": "Dismiss",
      "description": "Ends a manual alert's firing."
    },
    "ack": {
      "name": "Acknowledge",
      "description": "Acknowledges a firing alert, stopping its reminders until it stops firing."
    },
    "unack": {
      "name": "Remove acknowledgement",
      "description": "Removes an alert's acknowledgement, so that it is active again."
    }
  },
  "exceptions": {
    "not_acknowledgeable": {
      "message": "{entity_id} can't be acknowledged."
    },
    "not_manual": {
      "message": "{entity_id} isn't a manual alert, so it can't be fired or dismissed by action."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Alert Redux defaults",
        "data": {
          "no_data_grace": "No-data grace period",
          "startup_delay": "Startup delay"
        },
        "data_description": {
          "no_data_grace": "How long a firing alert keeps firing while its inputs have no data, unless the alert sets its own.",
          "startup_delay": "When Home Assistant starts, wait this long before evaluating condition alerts. Zero to evaluate straight away."
        }
      }
    }
  }
