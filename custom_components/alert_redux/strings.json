{
  "config": {
    "step": {
      "user": {
        "title": "Alert Redux",
        "description": "Set up Alert Redux alerting."
      }
    },
    "abort": {
      "single_instance_allowed": "[%key:common::config_flow::abort::single_instance_allowed%]"
    }
  },
  "config_subentries": {
    "alert": {
      "entry_type": "Alert",
      "initiate_flow": {
        "user": "Add alert"
      },
      "step": {
        "user": {
          "title": "Add a manual alert",
          "description": "A manual alert is fired and dismissed by the `alert_redux.fire` and `alert_redux.dismiss` actions.",
          "data": {
            "name": "Name",
            "priority": "Priority",
            "icon": "Icon",
            "acknowledgeable": "Acknowledgeable",
            "user_dismissable": "Dismissable from the card"
          },
          "data_description": {
            "name": "Shown on the card and used as the notification title. The entity ID is derived from it when the alert is created.",
            "priority": "Sets the alert's colour and sort order.",
            "icon": "Leave empty to use the priority's default icon.",
            "acknowledgeable": "Turn off for alerts that must not be silenced.",
            "user_dismissable": "Show a dismiss button on the card. The dismiss action always works, whatever this is set to."
          }
        },
        "reconfigure": {
          "title": "Edit alert",
          "data": {
            "name": "[%key:component::alert_redux::config_subentries::alert::step::user::data::name%]",
            "priority": "[%key:component::alert_redux::config_subentries::alert::step::user::data::priority%]",
            "icon": "[%key:component::alert_redux::config_subentries::alert::step::user::data::icon%]",
            "acknowledgeable": "[%key:component::alert_redux::config_subentries::alert::step::user::data::acknowledgeable%]",
            "user_dismissable": "[%key:component::alert_redux::config_subentries::alert::step::user::data::user_dismissable%]"
          },
          "data_description": {
            "name": "Renaming doesn't change the entity ID; rename that in the entity settings if you want to.",
            "priority": "[%key:component::alert_redux::config_subentries::alert::step::user::data_description::priority%]",
            "icon": "[%key:component::alert_redux::config_subentries::alert::step::user::data_description::icon%]",
            "acknowledgeable": "[%key:component::alert_redux::config_subentries::alert::step::user::data_description::acknowledgeable%]",
            "user_dismissable": "[%key:component::alert_redux::config_subentries::alert::step::user::data_description::user_dismissable%]"
          }
        }
      },
      "error": {
        "name_exists": "An alert with this name already exists."
      },
      "abort": {
        "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
      }
    }
  },
  "entity": {
    "alert_redux": {
      "alert": {
        "state": {
          "idle": "Idle",
          "active": "Active",
          "ack": "Acknowledged"
        },
        "state_attributes": {
          "priority": {
            "state": {
              "emergency": "[%key:component::alert_redux::selector::priority::options::emergency%]",
              "critical": "[%key:component::alert_redux::selector::priority::options::critical%]",
              "warning": "[%key:component::alert_redux::selector::priority::options::warning%]",
              "notice": "[%key:component::alert_redux::selector::priority::options::notice%]",
              "informational": "[%key:component::alert_redux::selector::priority::options::informational%]"
            }
          }
        }
      }
    }
  },
  "selector": {
    "priority": {
      "options": {
        "emergency": "Emergency",
        "critical": "Critical",
        "warning": "Warning",
        "notice": "Notice",
        "informational": "Informational"
      }
    }
  },
  "services": {
    "fire": {
      "name": "Fire",
      "description": "Fires a manual alert. Firing an alert that is already firing adds to its fire count and keeps its acknowledgement.",
      "fields": {
        "data": {
          "name": "Data",
          "description": "Variables made available to the alert's message templates as `fire_data`."
        }
      }
    },
    "dismiss": {
      "name": "Dismiss",
      "description": "Ends a manual alert's firing."
    },
    "ack": {
      "name": "Acknowledge",
      "description": "Acknowledges a firing alert, stopping its reminders until it stops firing."
    },
    "unack": {
      "name": "Remove acknowledgement",
      "description": "Removes an alert's acknowledgement, so that it is active again."
    }
  },
  "exceptions": {
    "not_acknowledgeable": {
      "message": "{entity_id} can't be acknowledged."
    },
    "not_manual": {
      "message": "{entity_id} isn't a manual alert, so it can't be fired or dismissed by action."
    }
  }
}
